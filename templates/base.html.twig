<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% block title %}Bienvenue{% endblock %}</title>

		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
			{{ encore_entry_link_tags('navbar') }}
		{% endblock %}

		{% block javascripts %}

			{# JQUERY #}
			<script type="text/javascript" src="{{ asset('/jquery/3.6.1/min.js') }}"></script>

			{# FOSJsRouting #}
			<script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
			<script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>

			{{ encore_entry_script_tags('app') }}
			{{ encore_entry_script_tags('navbar') }}
		{% endblock %}
	</head>
	<body class="{% block body_class %}{% endblock %}">

		{# HEADER #}
		{% block header %}{% include 'partiel/_header.html.twig' %}{% endblock %}

		{# NAVBAR #}
		{% block navbar %}{% include 'navbar/index.html.twig' %}{% endblock %}

		{# MESSAGES FLASH SUCCESS #}
		{% for message in app.flashes('success') %}
			<div class="flash-notice mt-3 mb-3 bg-success text-center text-white">
				Succès : {{ message|raw }}
			</div>
		{% endfor %}

		{# MESSAGES FLASH ERROR #}
		{% for message in app.flashes('error') %}
			<div class="flash-notice mt-3 mb-3 bg-danger text-center text-white">
				Erreur : {{ message|raw }}
			</div>
		{% endfor %}

		{# BODY #}
		{% block body %}{% endblock %}

		{# FOOTER #}
		{% block footer %}{% include 'partiel/_footer.html.twig' %}{% endblock %}

		{# TOASTER #}
		{% set toaster_messages = app.flashes('toaster') %}
		{% set toaster_message = toaster_messages|first|default(message_toaster is defined ? message_toaster : '') %}
		<div id="toaster" class="pointer" role="status" aria-live="polite" aria-atomic="true" data-toaster="{{ toaster_message|e('html_attr') }}"></div>
	</body>
</html>
