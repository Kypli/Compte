{{ form_start(form, form_options|default({})) }}
	<div class="patrimoine-form">
		<div class="patrimoine-form-grid">
			<div>
				{{ form_label(form.libelle) }}
				{{ form_widget(form.libelle) }}
				{{ form_errors(form.libelle) }}
			</div>
			<div>
				{{ form_label(form.valeur) }}
				{{ form_widget(form.valeur) }}
				{{ form_errors(form.valeur) }}
			</div>
			<div class="patrimoine-form-full">
				{{ form_label(form.categorie) }}
				{{ form_widget(form.categorie) }}
				{{ form_errors(form.categorie) }}
			</div>
			<div class="patrimoine-form-full">
				{{ form_label(form.description) }}
				{{ form_widget(form.description) }}
				{{ form_errors(form.description) }}
			</div>
		</div>
		<div class="patrimoine-form-actions">
			{% if not hide_cancel|default(false) %}
				<a href="{{ path('immobilier') }}" class="btn btn-secondary">Annuler</a>
			{% endif %}
			<button class="btn btn-success">{{ button_label|default('Enregistrer') }}</button>
		</div>
	</div>
{{ form_end(form) }}
