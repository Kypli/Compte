{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('home') }}
{% endblock %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
	<div class="home-password-reset-page">
		<form class="home-password-reset-box" action="{{ path('reset_password', { token: token }) }}" method="post">
			<h1>Nouveau mot de passe</h1>
			<p>Choisissez un nouveau mot de passe securise pour votre compte.</p>

			{% for message in app.flashes('login_error') %}
				<div class="flash-notice mt-2 mb-3 bg-danger text-center text-white">
					Erreur : {{ message|raw }}
				</div>
			{% endfor %}

			<input
				class="p-2 taille20"
				type="password"
				name="_password"
				placeholder="Nouveau mot de passe"
				required="required"
				minlength="6"
				pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}"
				title="Minimum 6 caracteres, avec au moins 1 majuscule, 1 minuscule et 1 chiffre."
				autocomplete="new-password"
			/>
			<input
				class="p-2 taille20"
				type="password"
				name="_password_confirm"
				placeholder="Confirmer le mot de passe"
				required="required"
				minlength="6"
				pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}"
				title="Minimum 6 caracteres, avec au moins 1 majuscule, 1 minuscule et 1 chiffre."
				autocomplete="new-password"
			/>
			<input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password_' ~ token) }}">

			<div class="home-password-reset-actions">
				<button class="p-2 taille20 home-login-submit" type="submit">
					Changer le mot de passe
				</button>
				<a class="home-password-reset-back" href="{{ path('home') }}">Retour</a>
			</div>
		</form>
	</div>
{% endblock %}
