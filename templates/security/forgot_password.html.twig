{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('home') }}
{% endblock %}

{% block title %}Mot de passe oublie{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
	<div class="home-password-reset-page">
		<form class="home-password-reset-box" action="{{ path('forgot_password_request') }}" method="post">
			<h1>Mot de passe oublie</h1>
			<p>Indiquez votre login ou votre email. Si un compte existe, un lien de reinitialisation vous sera envoye.</p>

			{% for message in app.flashes('login_error') %}
				<div class="flash-notice mt-2 mb-3 bg-danger text-center text-white">
					Erreur : {{ message|raw }}
				</div>
			{% endfor %}

			<input
				class="p-2 taille20"
				type="text"
				name="identifier"
				placeholder="Login ou email"
				value="{{ last_identifier }}"
				required="required"
				autocomplete="username"
			/>
			<input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password_request') }}">

			<div class="home-password-reset-actions">
				<button class="p-2 taille20 home-login-submit" type="submit">
					Recevoir le lien
				</button>
				<a class="home-password-reset-back" href="{{ path('home') }}">Retour</a>
			</div>
		</form>
	</div>
{% endblock %}
