{% extends 'base.html.twig' %}

{% block title %}Bien immobilier{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('patrimoine') }}
{% endblock %}

{% block body %}
	<div class="container patrimoine-page">
		{% include('partiel/_h1.html.twig') with {'text': immobilier.libelle} %}

		<table class="table patrimoine-table patrimoine-detail">
			<tbody>
				<tr>
					<th>Valeur</th>
					<td>{{ immobilier.valeur|money_display(app.user.preferences.moneyDisplayFormat|default('comma'), app.user.preferences.moneyCurrency|default('EUR'), app.user.preferences.moneyTrimZeros|default(false), (app.user.preferences.moneyShowZeroDecimals ?? true)) }}</td>
				</tr>
				<tr>
					<th>Adresse</th>
					<td>{{ immobilier.adresse|default('') }}</td>
				</tr>
				<tr>
					<th>Surface</th>
					<td>{{ immobilier.surface is not empty ? immobilier.surface ~ ' m²' : '' }}</td>
				</tr>
				<tr>
					<th>Notes</th>
					<td>{{ immobilier.description|nl2br }}</td>
				</tr>
			</tbody>
		</table>

		<div class="patrimoine-form-actions patrimoine-detail">
			<a href="{{ path('immobilier') }}" class="btn btn-secondary">Retour</a>
			<a href="{{ path('immobilier_edit', {'id': immobilier.id}) }}" class="btn btn-primary">Modifier</a>
		</div>
	</div>
{% endblock %}
