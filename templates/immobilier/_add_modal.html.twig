<div
	class="modal fade patrimoine-add-modal"
	id="{{ id }}"
	tabindex="-1"
	role="dialog"
	aria-labelledby="{{ id }}Title"
	aria-hidden="true"
	data-open="{{ open ? '1' : '0' }}"
>
	<div class="modal-dialog modal-lg modal-dialog-centered" role="document">
		<div class="modal-content patrimoine-modal">
			<div class="modal-header patrimoine-modal-header">
				<h5 class="modal-title" id="{{ id }}Title">{{ title }}</h5>
				<button type="button" class="close patrimoine-modal-close" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Fermer">
					<span aria-hidden="true">&times;</span>
				</button>
			</div>
			<div class="modal-body">
				{{ include(form_template, {
					'form': form,
					'hide_cancel': true,
					'form_options': {
						'action': path('immobilier'),
						'attr': {'id': form_id}
					}
				}) }}
			</div>
		</div>
	</div>
</div>
