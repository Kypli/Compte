{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body_class %}dashboard-background-{{ app.user.preferences.dashboardBackground|default('green') }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('dashboard') }}
	{{ encore_entry_link_tags('patrimoine') }}
	{{ encore_entry_link_tags('credit') }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('dashboard') }}
{% endblock %}

{% block body %}
	<div class="container">

		{% include('partiel/_h1.html.twig') with {'text': 'Tableau de bord'} %}

		<div class="row mb-3 mlDashBoard">
			<div class="col-5 card encard m-2">
				<h2>Comptes</h2>
				<div class="row">
					{% include('dashboard/_commun_add.html.twig') with {'lien': 'compte'} %}
				</div>
			</div>
			<div class="col-5 card encard m-2">
				<h2>Crédit</h2>
				<div class="row">
					{% include('dashboard/_commun_add.html.twig') with {'lien': 'credit'} %}
				</div>
			</div>
		</div>

		<div class="row mb-3 mlDashBoard">
			<div class="offset-1 col-5 card encard m-2">
				<h2>Immobilier</h2>
				<div class="row">
					{% include('dashboard/_commun_add.html.twig') with {'lien': 'immobilier'} %}
				</div>
			</div>
			<div class="offset-1 col-5 card encard m-2">
				<h2>Mobilier</h2>
				<div class="row">
					{% include('dashboard/_commun_add.html.twig') with {'lien': 'mobilier'} %}
				</div>
			</div>
		</div>

		<div class="row mlDashBoard">
			<div class="offset-1 col-5 card encard m-2">
				<h2>Investissement</h2>
				<div class="row">
					{% include('dashboard/_commun_add.html.twig') with {'lien': 'investissement'} %}
				</div>
			</div>
			<div class="offset-1 col-5 card encard-bis m-2">
				<h2 class='no-underline ls2 pt-2 pb-2'>TOTAL</h2>
				<div class="row">
					{% include('dashboard/_total.html.twig') %}
				</div>
			</div>
		</div>

		{% include('dashboard/_add_modal.html.twig') with {
			'id': 'modalCompteAdd',
			'title': 'Ajouter un compte',
			'form': compte_form,
			'form_id': 'dashboardCompteForm',
			'form_template': 'compte/_form.html.twig',
			'open': open_compte_modal
		} %}
		{% include('dashboard/_add_modal.html.twig') with {
			'id': 'modalCreditAdd',
			'title': 'Ajouter un credit',
			'form': credit_form,
			'form_id': 'dashboardCreditForm',
			'form_template': 'credit/_form.html.twig',
			'open': open_credit_modal
		} %}
		{% include('dashboard/_add_modal.html.twig') with {
			'id': 'modalImmobilierAdd',
			'title': 'Ajouter un bien immobilier',
			'form': immobilier_form,
			'form_id': 'dashboardImmobilierForm',
			'form_template': 'immobilier/_form.html.twig',
			'open': open_immobilier_modal
		} %}
		{% include('dashboard/_add_modal.html.twig') with {
			'id': 'modalMobilierAdd',
			'title': 'Ajouter un bien mobilier',
			'form': mobilier_form,
			'form_id': 'dashboardMobilierForm',
			'form_template': 'mobilier/_form.html.twig',
			'open': open_mobilier_modal
		} %}
		{% include('dashboard/_add_modal.html.twig') with {
			'id': 'modalInvestissementAdd',
			'title': 'Ajouter un investissement',
			'form': investissement_form,
			'form_id': 'dashboardInvestissementForm',
			'form_template': 'invest/_form.html.twig',
			'open': open_investissement_modal
		} %}
	</div>
{% endblock %}
