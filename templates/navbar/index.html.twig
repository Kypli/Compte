<nav class="navbar navbar-expand-custom navbar-mainbg">
	{% set current_route = app.request.attributes.get('_route') %}
	{# <a class="navbar-brand navbar-logo" href="{{ path('home') }}">Navbar</a> #}
	<button
		class="navbar-toggler"
		type="button"
		aria-controls="navbarSupportedContent"
		aria-expanded="false"
		aria-label="Toggle navigation"
	>
		<i class="fas fa-bars text-white"></i>
	</button>

	<div class="collapse navbar-collapse" id="navbarSupportedContent">
		<ul class="navbar-nav decaleLeftUl">
			<div class="hori-selector">
				<div class="left"></div>
				<div class="right"></div>
			</div>
			<li class="nav-item decaleLeftLi {{ current_route == 'tableau_bord' ? 'active' }}">
				<a class="nav-link" href="{{ current_route == 'tableau_bord' ? '#' : path('tableau_bord') }}">
					<i class="fas fa-tachometer-alt"></i>
					Tableau de bord
				</a>
			</li>
			<li class="nav-item decaleLeftLi {{ current_route starts with 'compte' ? 'active' }}">
				<a class="nav-link" href="{{ current_route == 'compte' ? '#' : path('compte') }}">
					<i class="fa-solid fa-sack-dollar"></i>
					Comptes
				</a>
			</li>
			<li class="nav-item decaleLeftLi {{ current_route starts with 'credit' ? 'active' }}">
				<a class="nav-link" href="{{ current_route == 'credit' ? '#' : path('credit') }}">
					<i class="fa-solid fa-comments-dollar"></i>
					Crédit
				</a>
			</li>
			<li class="nav-item decaleLeftLi {{ current_route starts with 'immobilier' or current_route starts with 'mobilier' ? 'active' }}">
				<a class="nav-link" href="{{ current_route == 'immobilier' ? '#' : path('immobilier') }}">
					<i class="fa-sharp fa-solid fa-house"></i>
					Immobilier / Mobilier
				</a>
			</li>
			<li class="nav-item decaleLeftLi {{ current_route starts with 'investissement' ? 'active' }}">
				<a class="nav-link" href="{{ current_route == 'investissement' ? '#' : path('investissement') }}">
					<i class="fa-solid fa-money-bill-trend-up"></i>
					Investissement
				</a>
			</li>

			{# ANONYME #}
			{% if app.user.anonyme %}
				<li class="nav-item decaleLeftLi nav-register-item">
					<a class="nav-link nav-register-link" href="{{ path('user_edit', {'id': app.user.id}) }}">
						<i class="fa-solid fa-star"></i></i>
						S'enregistrer
					</a>
				</li>

			{# USER #}
			{% else %}
				<li class="nav-item decaleLeftLi {{ current_route == 'user_preference' ? 'active' }}">
					<a class="nav-link" href="{{ current_route == 'user_preference' ? '#' : path('user_preference', {'id': app.user.id}) }}">
						<i class="fa-solid fa-star"></i></i>
						Préférences
					</a>
				</li>
				<li class="nav-item decaleLeftLi {{ current_route in ['user', 'user_show', 'user_edit'] ? 'active' }}">
					<a class="nav-link" href="{{ current_route == 'user_show' ? '#' : path('user_show', {'id': app.user.id}) }}">
						<i class="fa-solid fa-user"></i></i>
						Profil
					</a>
				</li>
				<li class="nav-item decaleLeftLi {{ current_route starts with 'logout' ? 'active' }}">
					<a class="nav-link" href="{{ current_route == 'logout' ? '#' : path('logout') }}">
						<i class="fa-solid fa-power-off" title='Déconnexion'></i>
						Se déconnecter
					</a>
				</li>
			{% endif %}
		</ul>
	</div>
	<a class="navbar-logo-placeholder" href="{{ path('home') }}" aria-label="Retour à l'accueil">
		<img src="https://placehold.co/96x42?text=Logo" alt="Logo" />
	</a>
</nav>
