{{ form_start(form, {'attr': {'class': 'user-anonymous-register-panel'}}) }}
	<div class="row form_login">
		<div class="col-12 d-flex justify-content-center home-register-choice">
			<a class="home-google-connect" href="{{ path('connect_google_start') }}">
				<svg class="user-google-icon" viewBox="0 0 18 18" aria-hidden="true">
					<path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84c-.21 1.13-.84 2.08-1.8 2.72v2.26h2.91c1.7-1.57 2.69-3.87 2.69-6.62Z"></path>
					<path fill="#34A853" d="M9 18c2.43 0 4.47-.81 5.96-2.18l-2.91-2.26c-.81.54-1.84.86-3.05.86-2.34 0-4.33-1.58-5.04-3.71H.96v2.33C2.44 15.98 5.48 18 9 18Z"></path>
					<path fill="#FBBC05" d="M3.96 10.71A5.41 5.41 0 0 1 3.68 9c0-.59.1-1.17.28-1.71V4.96H.96A9.01 9.01 0 0 0 0 9c0 1.45.35 2.83.96 4.04l3-2.33Z"></path>
					<path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0 5.48 0 2.44 2.02.96 4.96l3 2.33C4.67 5.17 6.66 3.58 9 3.58Z"></path>
				</svg>
				Continuer avec Google
			</a>
		</div>

		<div class="col-12 home-register-choice">
			<div class="home-login-separator">OU</div>
		</div>

		<div class="col-12">
			{{ form_errors(form.userName) }}
			{{ form_widget(form.userName, {'attr': form.userName.vars.attr|merge({
				'class': 'p-2 taille20',
				'placeholder': 'Login, Email ou Pseudo',
				'autocomplete': 'username'
			})}) }}
		</div>

		<div class="col-12 mt-3 home-register-fields">
			{{ form_errors(form.email) }}
			{{ form_widget(form.email, {'attr': form.email.vars.attr|merge({
				'class': 'p-2 taille20',
				'placeholder': 'Email'
			})}) }}
		</div>

		<div class="col-12 mt-4">
			{{ form_errors(form.password) }}
			<div class="home-password-field">
				{{ form_widget(form.password, {'attr': form.password.vars.attr|merge({
					'class': 'p-2 taille20 gg',
					'placeholder': 'Mot de passe',
					'autocomplete': 'new-password',
					'data-password-input': ''
				})}) }}
				<button type="button" class="home-password-toggle" aria-label="Afficher le mot de passe" data-password-toggle>
					<svg class="home-password-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
						<circle cx="12" cy="12" r="3"></circle>
						<path class="home-password-slash" d="M4 4l16 16"></path>
					</svg>
				</button>
			</div>
		</div>

		<div class="col-12 mt-3 mb-3 home-register-fields">
			{{ form_errors(form.passwordConfirm) }}
			<div class="home-password-field">
				{{ form_widget(form.passwordConfirm, {'attr': form.passwordConfirm.vars.attr|merge({
					'class': 'p-2 taille20 gg',
					'placeholder': 'Confirmer le MdP',
					'autocomplete': 'new-password',
					'data-password-input': ''
				})}) }}
				<button type="button" class="home-password-toggle" aria-label="Afficher le mot de passe" data-password-toggle>
					<svg class="home-password-icon" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
						<circle cx="12" cy="12" r="3"></circle>
						<path class="home-password-slash" d="M4 4l16 16"></path>
					</svg>
				</button>
			</div>
		</div>

		{{ form_rest(form) }}

		<div class="col-12">
			<button class="p-2 m-2 mt-0 taille22 home-login-submit home-login-create" type="submit">
				{{ button_label|default("S'enregistrer") }}
			</button>
		</div>
	</div>
{{ form_end(form, {'render_rest': false}) }}
