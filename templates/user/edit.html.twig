{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('user') }}
{% endblock %}

{% block title %}{{ user.anonyme ? "S'enregistrer" : 'Modifier mes informations' }}{% endblock %}

{% block body %}

	<div class="container">
		<div class='row mb-3'>

			{# TITRE #}
			<h2 class="radius-long offset-4 col-4">{{ user.anonyme ? "S'enregistrer" : 'Modifier mes informations' }}</h2>

			{# MODIFIER USER #}
			<section class="form {{ user.anonyme ? 'user-register-form' }}">
				<div class="{{ user.anonyme ? 'col-12 register-return' : 'col-2' }} m-2 mb-0 p-1 pb-0 alignLeft">
					<a href="{{ user.anonyme ? path('home') : path('user_show', {'id': user.id}) }}">
						<i class="fas fa-backward" title="{{ user.anonyme ? "Retour à l'accueil" : 'Retour' }}"></i>
						{{ user.anonyme ? "Retour à la page d'accueil" : 'Retour' }}
					</a>
				</div>

				{# FORM #}
				{% if user.anonyme %}
					{% include 'user/_form_register_anonymous.html.twig' %}
				{% else %}
					{% include 'user/_form_edit.html.twig' %}
				{% endif %}

				{# FORM DELETE #}
				{% if not user.anonyme %}
					{{ include('user/_form_delete.html.twig') }}
				{% endif %}
			</section>
		</div>
	</div>
{% endblock %}
