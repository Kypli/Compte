{{ form_start(form) }}

	{% set label = label_class|default('col-5 offset-1 mb-4 alignRight') %}
	{% set widget = widget_class|default('col-3 mb-4') %}
	{% set submit = submit_class|default('offset-6 col-2') %}
	{% set row = row_class|default('row center mt-4') %}

	<div class="{{ row }}">

		{# LOGIN #}
		<div class="{{ label }}">
			{{ form_label(form.userName) }}
		</div>
		<div class="{{ widget }}">
			{{ form_widget(form.userName) }}
		</div>
		<div class="w-100"></div>

		{# MOT DE PASSE #}
		<div class="{{ label }}">
			{{ form_label(form.password) }}
		</div>
		<div class="{{ widget }}">
			{{ form_widget(form.password) }}
		</div>
	</div>

	{{ form_widget(form) }}

	<div class="{{ submit }}">
		<button class="m-2 mt-0 floatleft radius-button taille22">
			&nbsp;&nbsp;{{ button_label|default("S'enregistrer") }}&nbsp;&nbsp;
		</button>
	</div>
{{ form_end(form) }}
