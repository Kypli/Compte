<div
	id="modalAnomalies"
	class="modal fade"
	tabindex="-1"
	role="dialog"
	aria-labelledby="modalAnomaliesTitle"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" role="document">
		<div class="modal-content anomalies-modal-content">
			<div class="modal-header">
				<div>
					<h4 id="modalAnomaliesTitle" class="modal-title">Correction des anomalies</h4>
					<p class="anomalies-modal-summary">
						{{ anomalies|length }} anomalie{{ anomalies|length > 1 ? 's' }} détectée{{ anomalies|length > 1 ? 's' }}
					</p>
				</div>
				<button
					type="button"
					class="legend-close-button"
					data-dismiss="modal"
					aria-label="Fermer"
					title="Fermer"
				>
					<i class="fa-solid fa-xmark" aria-hidden="true"></i>
				</button>
			</div>

			<div class="modal-body">
				{% if anomalies is empty %}
					<div class="anomalies-empty">
						<i class="fa-solid fa-circle-check" aria-hidden="true"></i>
						<strong>Aucune anomalie détectée</strong>
						<span>Les opérations anticipées sont à jour.</span>
					</div>
				{% else %}
					<ul class="anomalies-list">
						{% for anomaly in anomalies %}
							{% set category = anomaly.subcategory.category %}
							<li class="anomaly-item">
								<div class="anomaly-icon" aria-hidden="true">
									<i class="fa-solid fa-calendar-xmark"></i>
								</div>
								<div class="anomaly-description">
									<strong>Date anticipée dépassée</strong>
									<span class="action-zone-{{ category.sign ? 'pos' : 'neg' }}">
										{{ category.libelle|capitalize }} / {{ anomaly.subcategory.libelle|capitalize }}
									</span>
									<small>
										Prévue le {{ anomaly.date|date('d/m/Y') }} · {{ anomaly.number|number_format(2, ',', ' ') }} €
									</small>
								</div>
								<div class="anomaly-solution">
									<span class="anomaly-solution-label">Choisir une correction</span>
									<div class="anomaly-postpone">
										<label>
											<input
												type="date"
												class="anomaly-postpone-date"
												aria-label="Nouvelle date"
												min="{{ 'tomorrow'|date('Y-m-d') }}"
											>
										</label>
										<button
											type="button"
											class="resolve-anomaly-button resolve-anomaly-postpone"
											data-url="{{ path('compte_anomaly_resolve', {'id': compte.id, 'operation': anomaly.id}) }}"
											data-token="{{ csrf_token('resolve-operation-anomaly' ~ anomaly.id) }}"
											data-resolution="postpone"
										>
											<i class="fa-solid fa-calendar-plus" aria-hidden="true"></i>
											<span>Reporter</span>
										</button>
									</div>
									<button
										type="button"
										class="resolve-anomaly-button resolve-anomaly-realize"
										data-url="{{ path('compte_anomaly_resolve', {'id': compte.id, 'operation': anomaly.id}) }}"
										data-token="{{ csrf_token('resolve-operation-anomaly' ~ anomaly.id) }}"
										data-resolution="realize"
									>
										<i class="fa-solid fa-check" aria-hidden="true"></i>
										<span>Marquer comme réalisée</span>
									</button>
									<button
										type="button"
										class="resolve-anomaly-button resolve-anomaly-delete"
										data-url="{{ path('compte_anomaly_resolve', {'id': compte.id, 'operation': anomaly.id}) }}"
										data-token="{{ csrf_token('resolve-operation-anomaly' ~ anomaly.id) }}"
										data-resolution="delete"
									>
										<i class="fa-solid fa-trash-can" aria-hidden="true"></i>
										<span>Supprimer la ligne</span>
									</button>
								</div>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-dark" data-dismiss="modal">Fermer</button>
			</div>
		</div>
	</div>
</div>
