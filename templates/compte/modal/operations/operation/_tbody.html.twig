{% for ope in operations %}

	{# DATE #}
	{% set day = ope.day < 10 ? '0' ~ ope.day  : ope.day  %}
	{% set month = ope.month < 10 ? '0' ~ ope.month : ope.month %}

	{# DEAL WITH 0 #}
	{% set number = ope.number|money_display(app.user.preferences.moneyDisplayFormat|default('comma'), app.user.preferences.moneyCurrency|default('EUR'), app.user.preferences.moneyTrimZeros|default(false), (app.user.preferences.moneyShowZeroDecimals ?? true)) %}

	{# TBODY - TR #}
	<tr id='ope_id_{{ ope.id }}' class='tr_ope' data-assignee-id='{{ ope.assigneeId|default('') }}'>
		<td class='td_number'>{{ ope.anticipe ? '' : number }}</td>
		<td class='td_switch'>
			<span class='switch hide'>
				<i class='fa-solid fa-repeat' title='Basculer entre montant fait et montant à venir' aria-label='Basculer entre montant fait et montant à venir'></i>
			</span>
		</td>
		<td class='td_anticipe'>{{ ope.anticipe ? number : '' }}</td>
		<td class='td_date p-1'>
			<span class='day'>{{ day }}</span>/<span class='date-month'>{{ month }}</span>/<span class='date-year'>{{ ope.year }}</span>
		</td>
		<td class='td_comment p-1'>{{ ope.comment|capitalize }}</td>
		<td class='td_actions{{ canEdit ? " row" : " operation-readonly-actions" }}'>
			{% if canEdit %}
			<div class='hide btn-group col-4 ecart-left-5 operation-action-menu' role='group'>
				<button
					type='button'
					class='btn btn-default dropdown-toggle'
					data-toggle='dropdown'
					aria-haspopup='true'
					aria-expanded='false'
				>
					<i class='fas fa-cog'></i>
					<span class='caret'></span>
				</button>
				<ul class='dropdown-menu options p-1'>
					<li class='duplicateOperation' data-opeid='{{ ope.id }}' title="Dupliquer cette opération sur les mois restants de l'année en cours">Dupliquer</li>
					<li class='changeOperationDate' title="Modifier le mois et l'année de cette opération">Changer le mois/année</li>
					{% if canAssign %}
						<li
							class='assignOperation{{ ope.assigneeId|default(null) ? ' operation-option-selected' : '' }}'
							data-opeid='{{ ope.id }}'
							title="{{ ope.assigneeId|default(null) ? 'Attribuée à ' ~ ope.assigneeName : 'Attribuer cette opération à une personne' }}"
						>Attribuer</li>
					{% endif %}
					<li class='invalid noForm'>Retire mode édition</li>
					<li class='invalid'>...</li>
					<li><hr></li>
					<li class='delete' data-opeid='{{ ope.id }}'>Supprimer</li>
				</ul>
			</div>
			<div class='offset-2 col-4'>

				{# STOP FORM MOD (GREY) #}
				<button
					type='button'
					class='btn btn-outline-secondary mt-2 mb-2 pt-0 pb-0 hide trButStopFormMod'
					title='Fermer le mode édition'
					data-opeid='{{ ope.id }}'
				>
					<i class='fas fa-times'></i>
				</button>

				{# RESET EDIT (BLUE) #}
				<button
					type='button'
					class='btn btn-outline-primary mt-2 mb-2 pt-0 pb-0 hide trButCancelEdit'
					title='Annuler les modifications'
					data-opeid='{{ ope.id }}'
				>
					<i class='fas fa-times'></i>
				</button>

				{# STOP ADD (GREEN) #}
				<button
					type='button'
					class='btn btn-outline-succes mt-2 mb-2 pt-0 pb-0 hide trButDelAdd'
					title='Retirer cet ajout de ligne'
					data-opeid='{{ ope.id }}'
				>
					<i class='fas fa-times'></i>
				</button>

				{# STOP DELETE (RED) #}
				<button
					type='button'
					class='btn btn-outline-danger mt-2 mb-2 pt-0 pb-0 hide trButRevive'
					title='Annuler cette suppression de ligne'
					data-opeid='{{ ope.id }}'
				>
					<i class='fas fa-times'></i>
				</button>
			</div>
			{% endif %}
		</td>
	</tr>
{% endfor %}
