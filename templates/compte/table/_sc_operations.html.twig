{# NO OPERATIONS #}
{% if operations[subcategory.id] is not defined %}
	{{ include('compte/table/empty/_sc.html.twig') }}

{# SC OPERATIONS #}
{% else %}

	{% set operationsBySc = operations[subcategory.id] %}

	{# MOIS AFFICHES #}
	{% for month in visible_months %}

			{% set month_year = visible_month_years[month]|default(year) %}
{# VAR #}
		{% set reel = 0 %}
		{% set blink = '' %}
		{% set anticipe = 0 %}
		{% set month_is_detailed = month in detail_months %}
		{% set month_is_collapsed = month not in detail_months %}
		{% set show_anticipation_column = month_anticipation_visible['m' ~ month]|default(true) %}
		{% set done =
				current_year > month_year or (current_year == month_year and month < current_month)
					? 'done '
					: current_year == month_year and month == current_month
						? 'current '
						: ''
		%}

		{% if operationsBySc[month] is defined %}

			{% set data = operationsBySc[month] %}
			{% set reel = data['reel'] is defined ? data['reel'] : 0 %}

			{% if data['anticipe'] is defined and data['anticipe'] != 0 %}
				{% set anticipe = data['anticipe'] %}
				{% set blink = month_year < current_year or (month_year == current_year and month < current_month) ? 'blink_me ' : '' %}
			{% endif %}
		{% endif %}

		{% if month_is_collapsed %}
			<td
			class="month-cell-span {{ done|trim }} month-detail-collapsed{{ loop.last ? ' month-cell-last' }}"
				data-month="{{ month }}" data-year="{{ month_year }}"
			></td>
		{% elseif month_is_detailed %}
			{# REEL #}
			<td
				colspan="{{ show_anticipation_column ? 1 : 2 }}"
				class="{{ show_anticipation_column ? 'month-cell-start' : 'month-cell-span month-anticipation-hidden' }} {{ done|trim }}"
				data-month="{{ month }}" data-year="{{ month_year }}"
				data-scid="{{ subcategory.id }}"
				data-anticipe="0"
				data-target="#modalOperation"
				data-toggle="modal"
			>
				{{ reel|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
			</td>

			{# ANTICIPE #}
			{% if show_anticipation_column %}
				<td
					class='month-cell-end {{ done }}{{ blink }}anticipe{{ loop.last ? ' month-cell-last' }}'
					data-month="{{ month }}" data-year="{{ month_year }}"
					data-scid="{{ subcategory.id }}"
					data-anticipe="1"
					data-target="#modalOperation"
					data-toggle="modal"
				>
					{{ anticipe == 0 ? '' : anticipe|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</td>
			{% endif %}
		{% else %}
			<td
				class="month-cell-span {{ done|trim }}{{ blink }}{{ loop.last ? ' month-cell-last' }}"
				data-month="{{ month }}" data-year="{{ month_year }}"
				data-scid="{{ subcategory.id }}"
				data-anticipe="0"
				data-target="#modalOperation"
				data-toggle="modal"
			>
				{{ (reel + anticipe)|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
			</td>
		{% endif %}
	{% endfor %}

	{# SC TOTAL #}
	{% if show_table_totals %}
		<td class="year-total counterEdit done td_total_border">{{ operationsBySc['total']|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
	{% endif %}
	{% if show_table_monthly_average %}
		<td class="year-total counterEdit{{ not show_table_totals ? ' td_total_border' }} done">{{ (display_month_count > 0 ? operationsBySc['total'] / display_month_count : 0)|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
	{% endif %}
	{% if show_table_percentage %}
		<td class="year-total counterEdit{{ not show_table_totals and not show_table_monthly_average ? ' td_total_border' }} done">{{ operations['total_final'] != 0 ? ((operationsBySc['total']*100)/operations['total_final'])|round(2, 'ceil') : 0 }}</td>
	{% endif %}
{% endif %}
