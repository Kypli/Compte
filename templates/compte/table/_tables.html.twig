{% set money_display_format = money_display_format|default(user.preferences.moneyDisplayFormat|default('comma')) %}
{% set money_currency = money_currency|default(user.preferences.moneyCurrency|default('EUR')) %}
{% set money_trim_zeros = money_trim_zeros|default(user.preferences.moneyTrimZeros|default(false)) %}
{% set money_show_zero_decimals = money_show_zero_decimals ?? (user.preferences.moneyShowZeroDecimals ?? true) %}

<div class='row m-1'>

	{# TABLE + #}
	<div class="col-12 pt-2 bck_pos">
		<div class="compte-table-viewport">
			{% include('compte/table/_table.html.twig') with {'operations': operations_pos, 'sign': 'pos', 'signBool': true } %}
		</div>
	</div>

	{# TABLE - #}
	<div class="col-12 pt-2 bck_neg">
		<div class="compte-table-viewport">
			{% include('compte/table/_table.html.twig') with {'operations': operations_neg, 'sign': 'neg', 'signBool': false } %}
		</div>
	</div>

	{# SOLDE #}
	<div class="col-12 mb-5 pt-3 bck_solde">
		<div class="compte-table-viewport">
			{{ include('compte/table/_table_gains.html.twig') }}
		</div>
	</div>
</div>
