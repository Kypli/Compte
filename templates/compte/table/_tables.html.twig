{% set money_display_format = money_display_format|default(user.preferences.moneyDisplayFormat|default('comma')) %}
{% set money_currency = money_currency|default(user.preferences.moneyCurrency|default('EUR')) %}
{% set money_trim_zeros = money_trim_zeros|default(user.preferences.moneyTrimZeros|default(false)) %}
{% set money_show_zero_decimals = money_show_zero_decimals ?? (user.preferences.moneyShowZeroDecimals ?? true) %}
{% set show_monthly_gain = user.preferences.showBalanceTable ?? true %}
{% set show_annual_gain = user.preferences.showAnnualGain ?? true %}
{% set show_balance_cumulative = user.preferences.showBalanceCumulative ?? true %}

<div class='row m-1'>
	{% if user.preferences.mergeIncomeExpenseTables|default(false) %}
		<div class="col-12 pt-2 account-tables-merged">
			<h3 class="account-table-section-title account-table-section-title-merged">Tableau des entrées et dépenses</h3>
			<div class="compte-table-viewport">
				{% include('compte/table/_table_merged.html.twig') with {'month_anticipation_visible': month_anticipation_visible_merged, 'month_colspans': month_colspans_merged} %}
			</div>
		</div>
	{% else %}
		{# TABLE + #}
		<div class="col-12 pt-2 bck_pos">
			<h3 class="account-table-section-title account-table-section-title-income">Tableau des entrées</h3>
			<div class="compte-table-viewport">
				{% include('compte/table/_table.html.twig') with {'operations': operations_pos, 'sign': 'pos', 'signBool': true, 'month_anticipation_visible': month_anticipation_visible_pos, 'month_colspans': month_colspans_pos } %}
			</div>
		</div>

		{# TABLE - #}
		<div class="col-12 pt-2 bck_neg">
			<h3 class="account-table-section-title account-table-section-title-expense">Tableau des dépenses</h3>
			<div class="compte-table-viewport">
				{% include('compte/table/_table.html.twig') with {'operations': operations_neg, 'sign': 'neg', 'signBool': false, 'month_anticipation_visible': month_anticipation_visible_neg, 'month_colspans': month_colspans_neg } %}
			</div>
		</div>
	{% endif %}

	{# SOLDE #}
	{% if show_monthly_gain or show_annual_gain or show_balance_cumulative %}
		<div class="col-12 mb-5 pt-3 bck_solde account-gains-section">
			<h3 class="account-table-section-title account-table-section-title-gains">Tableau des gains</h3>
			<div class="compte-table-viewport">
				{{ include('compte/table/_table_gains.html.twig', {'month_colspans': month_colspans_merged}) }}
			</div>
		</div>
	{% endif %}
</div>
