{% set month_display_family = month_display|split('_')|first %}
{% set combined_compte = combined_compte|default(null) %}
{% set money_currency = money_currency|default(user.preferences.moneyCurrency|default('EUR')) %}
{% set money_symbol = money_currency|money_symbol %}
{% set show_table_totals = user.preferences.showTableTotals ?? true %}
{% set show_table_monthly_average = user.preferences.showTableMonthlyAverage ?? true %}
{% set show_table_percentage = user.preferences.showTablePercentage ?? true %}
{% set table_summary_colspan = (show_table_totals ? 1 : 0) + (show_table_monthly_average ? 1 : 0) + (show_table_percentage ? 1 : 0) %}
{% set show_sub_categories = user.preferences.showSubCategories ?? true %}
{% set label_colspan = show_sub_categories ? 2 : 1 %}
{% set view_comptes = view_comptes|default([compte]) %}
{% set displayed_categories = [] %}
{% for table_compte in view_comptes %}
	{% set account_categories = table_compte.categories
		|filter(category => category.sign == signBool and category.year == year)
		|sort((a, b) => a.position <=> b.position)
	%}
	{% set displayed_categories = displayed_categories|merge(account_categories) %}
{% endfor %}
{% if month_anticipation_visible is not defined %}
	{% set month_anticipation_visible = {} %}
	{% for key in visible_months %}
		{% set month_key = 'm' ~ key %}
		{% set month_year = visible_month_years[key]|default(year) %}
		{% set month_is_past = current_year > month_year or (current_year == month_year and key < current_month) %}
		{% set month_has_anticipation = operations['totaux_mois'][key]['anticipe_count']|default(0) > 0 %}
		{% set month_anticipation_visible = month_anticipation_visible|merge({ (month_key): not month_is_past or month_has_anticipation }) %}
	{% endfor %}
{% endif %}
{% if month_colspans is not defined %}
	{% set month_colspans = {} %}
	{% for key in visible_months %}
		{% set month_key = 'm' ~ key %}
		{% set month_colspans = month_colspans|merge({ (month_key): key in detail_months ? 2 : 1 }) %}
	{% endfor %}
{% endif %}

<table
	class="table compteTable center{{ combined_compte ? ' is-combined-account-table' }} month-display-{{ month_display }} month-display-{{ month_display_family }}{{ month_display_family in ['one', 'current', 'custom'] ? ' month-display-compact' }}"
	data-sign="{{ signBool == 1 ? '1' : '0' }}"
	data-category-reorder-url="{{ path('compte_category_reorder', {'id': compte.id}) }}"
	data-category-reorder-token="{{ csrf_token('reorder-categories' ~ compte.id) }}"
	data-subcategory-reorder-url="{{ path('compte_subcategory_reorder', {'id': compte.id}) }}"
	data-subcategory-reorder-token="{{ csrf_token('reorder-subcategories' ~ compte.id) }}"
>
	<thead>
		<tr class="tr_head">
			<th colspan='{{ label_colspan }}' {{ user.preferences.comptegenreshow ? "rowspan='2'" }} class='add_cat category-header col_start_top bck_{{ sign }}{{ user.preferences.comptegenreshow ? '' : ' category-header-single-row' }}'>
				{% if combined_compte %}
					<span class="combined-add-controls category-add-toolbar category-add-toolbar-single">
						<label class="category-add-target">
							<span>Ajouter dans</span>
							<select class="combined-account-target" aria-label="Compte cible pour la nouvelle catégorie">
								{% for table_compte in view_comptes %}<option value="{{ table_compte.id }}">{{ table_compte.libelle }}</option>{% endfor %}
							</select>
						</label>
						<button type="button" class="category-add-button {{ sign == 'pos' ? 'category-add-button-income' : 'category-add-button-expense' }}" data-target="#modalCategory" data-toggle="modal" aria-label="Ajouter une catégorie {{ sign == 'pos' ? "d'entrée" : 'de dépense' }}">
							<i class="fa-solid fa-plus" aria-hidden="true"></i>
							<span>Catégorie</span>
						</button>
					</span>
				{% else %}
					<button type="button" class="category-add-button {{ sign == 'pos' ? 'category-add-button-income' : 'category-add-button-expense' }}" data-accountid="{{ compte.id }}" data-target="#modalCategory" data-toggle="modal" aria-label="Ajouter une catégorie {{ sign == 'pos' ? "d'entrée" : 'de dépense' }}">
						<i class="fa-solid fa-plus" aria-hidden="true"></i>
						<span>Catégorie</span>
					</button>
				{% endif %}
			</th>

			{# MONTHS #}
			{% for key in visible_months %}
				{% set month = months[key] %}
				{% set month_year = visible_month_years[key]|default(year) %}
				{% set month_label = month|capitalize ~ (month_year != year ? ' ' ~ month_year : '') %}
				{% set month_is_detailed = key in detail_months %}
				{% set month_is_collapsed = key not in detail_months %}
				{% set month_colspan = month_colspans['m' ~ key]|default(1) %}
				{% set done =
						current_year > month_year or (current_year == month_year and key < current_month)
							? 'done'
							: current_year == month_year and key == current_month
								? 'current normal italique taille18'
								: 'normal'
				%}
				<th
					colspan='{{ month_colspan }}'
					id='month_{{ key }}'
					class="month-visible month-selector month-cell-span {{ done }}{{ month_is_collapsed ? ' month-detail-collapsed' : '' }}"
					data-month="{{ key }}" data-year="{{ month_year }}"
					role="button"
					tabindex="0"
					aria-pressed="false"
					title="Mettre {{ month_label }} en évidence"
				>{{ month_is_collapsed ? month_label|slice(0, 3) : month_label }}</th>
			{% endfor %}

			{# TOTAL #}
			{% if show_table_totals %}
				<th id='total' class="year-total td_total_border done col_end_top">Total</th>
			{% endif %}
			{% if show_table_monthly_average %}
				<th id='totalByMonth' class="year-total{{ not show_table_totals ? ' td_total_border' }} done col_end_top">X<span data-money-symbol>{{ money_symbol }}</span> / mois</th>
			{% endif %}
			{% if show_table_percentage %}
				<th id='percent' class="year-total{{ not show_table_totals and not show_table_monthly_average ? ' td_total_border' }} done col_end_top">%</th>
			{% endif %}
		</tr>
		{% if user.preferences.comptegenreshow %}
			<tr class="tr_etat">
				{% for month in visible_months %}
										{% set month_year = visible_month_years[month]|default(year) %}
					{% set month_is_detailed = month in detail_months %}
					{% set month_is_collapsed = month not in detail_months %}
					{% set done =
							current_year > month_year or (current_year == month_year and month < current_month)
								? 'done'
								: current_year == month_year and month == current_month
									? 'current'
									: ''
					%}
					{% if month_is_detailed %}
						{% set show_anticipation_column = month_anticipation_visible['m' ~ month]|default(true) %}
						<td
							colspan="{{ show_anticipation_column ? 1 : 2 }}"
							class="{{ show_anticipation_column ? 'month-cell-start' : 'month-cell-span month-anticipation-hidden' }} {{ done }}"
							data-month="{{ month }}"
							data-year="{{ month_year }}"
						>Fait</td>
						{% if show_anticipation_column %}
							<td class="month-cell-end {{ done }}" data-month="{{ month }}" data-year="{{ month_year }}">A ven.</td>
						{% endif %}
					{% else %}
						<td class="month-cell-span {{ done }} month-detail-collapsed" data-month="{{ month }}" data-year="{{ month_year }}"></td>
					{% endif %}
				{% endfor %}
				{% if table_summary_colspan > 0 %}<th colspan="{{ table_summary_colspan }}" class="year-total td_total_border done"></th>{% endif %}
			</tr>
		{% endif %}
	</thead>
	<tbody>
		{% for category in displayed_categories %}
			{% set is_last_displayed_category = loop.last %}
			{% for subcategory in category.subcategories|sort((a, b) => a.position <=> b.position) %}
				<tr class='{{ loop.first ? "tr_operation_first" }} edit' data-category-row="{{ category.id }}" data-accountid="{{ category.compte.id }}">

					{# CAT #}
					{% if loop.first %}
						{% set category_label_limit = category.subcategories|length >= 2 ? 36 : 18 %}
						<td
							data-target="#modalCategory"
							data-toggle="modal"
							data-id="{{ category.id }}"
							data-focusa="cat_{{ category.id }}"
							data-accountid="{{ category.compte.id }}"
							data-category-drop-before="{{ category.id }}"
							class='td_category_libelle{{ is_last_displayed_category ? " account-last-category-label" }}'
							rowspan='{{ category.subcategories|length }}'
						>
							<span class="category-label-content">
								<span class="category-label-text" title="{{ category.libelle|capitalize }}">{{ category.libelle|capitalize|smart_truncate(category_label_limit) }}</span>
								{% if combined_compte %}<span class="account-source-badge" title="Compte source">{{ category.compte.libelle }}</span>{% endif %}
								{% if not combined_compte and displayed_categories|length > 1 %}
									<button
										type="button"
										class="category-drag-handle"
										draggable="true"
										data-category-id="{{ category.id }}"
										aria-grabbed="false"
										aria-label="Déplacer la catégorie {{ category.libelle }}"
										title="Déplacer cette catégorie"
									>
										<i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
									</button>
								{% endif %}
							</span>
						</td>
					{% endif %}

					{# SC #}
					{% if show_sub_categories %}
						<td
						data-target="#modalCategory"
						data-toggle="modal"
						data-id="{{ category.id }}"
						data-focusa="sc_{{ subcategory.id }}"
						data-accountid="{{ category.compte.id }}"
						data-subcategory-drop-before="{{ subcategory.id }}"
						data-subcategory-category-id="{{ category.id }}"
						{% if loop.last %}data-subcategory-drop-end="{{ category.id }}"{% endif %}
						class='td_subcategory_libelle{{ is_last_displayed_category and loop.last ? " account-last-subcategory-label" }}'
					>
						<span class="subcategory-label-content">
							<span class="subcategory-label-text" title="{{ subcategory.libelle|capitalize }}">{{ subcategory.libelle|capitalize|smart_truncate(22) }}</span>
							{% if not combined_compte and category.subcategories|length > 1 %}
								<button
									type="button"
									class="subcategory-drag-handle"
									draggable="true"
									data-subcategory-id="{{ subcategory.id }}"
									data-subcategory-category-id="{{ category.id }}"
									aria-grabbed="false"
									aria-label="D&eacute;placer la sous-cat&eacute;gorie {{ subcategory.libelle }}"
									title="D&eacute;placer cette sous-cat&eacute;gorie"
								>
									<i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
								</button>
							{% endif %}
						</span>
						</td>
					{% endif %}

					{# OPE #}
					{{ include('compte/table/_sc_operations.html.twig') }}
				</tr>
			{% endfor %}
		{% endfor %}
		{{ include('compte/table/_table_totaux_mensuel.html.twig') }}
	</tbody>
</table>
