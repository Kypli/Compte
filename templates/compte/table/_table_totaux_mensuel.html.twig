{# EMPTY TR #}
<tr class="collabo">
	<td
		colspan="{{ label_colspan }}"
		class="col_start_middle bck_{{ sign }} category-drop-end"
		data-category-drop-end="true"
		tabindex="-1"
	>
		<span class="category-drop-end-label">Dernière position</span>
	</td>
	<td colspan="{{ month_colspan }}" class="bck_{{ sign }}"></td>
	{% if table_summary_colspan > 0 %}<td colspan="{{ table_summary_colspan }}" class="col_start_middle bck_{{ sign }}"></td>{% endif %}
</tr>

{# TOTAUX #}

	{# DETAILS (reel & anticipe) #}
	<tr>
		<td colspan="{{ label_colspan }}" class="col_start_bottom bck_{{ sign }}"></td>
		{% if operations['totaux_mois'] is defined %}

			{% for month in visible_months %}
					{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = user.preferences.comptegenreshow and month in detail_months %}
{% set month_is_collapsed = user.preferences.comptegenreshow and month not in detail_months %}
				{% set done =
					current_year > month_year or (current_year == month_year and month < current_month)
						? 'done'
						: current_year == month_year and month == current_month
							? 'current'
							: ''
				%}
				{% set ope = operations['totaux_mois'][month] is defined ? operations['totaux_mois'][month] : {} %}
				{% set reel = ope['reel'] is defined ? ope['reel'] : 0 %}
				{% set anticipe = ope['anticipe'] is defined ? ope['anticipe'] : 0 %}
				{% set total = ope['total'] is defined ? ope['total'] : reel + anticipe %}

				{% if month_is_collapsed %}
					<td class="month-cell-span {{ done }} month-detail-collapsed" data-month="{{ month }}" data-year="{{ month_year }}"></td>
				{% elseif month_is_detailed %}
					<td class="month-cell-start {{ done }} total_month_detail_{{ sign }}" data-month="{{ month }}" data-year="{{ month_year }}">
						{{ reel|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
					</td>
					<td class="month-cell-end {{ done }} total_month_detail_{{ sign }}" data-month="{{ month }}" data-year="{{ month_year }}">
						{{ anticipe|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
					</td>
				{% else %}
					<td class="month-cell-span {{ done }} total_month_full_{{ sign }}" data-month="{{ month }}" data-year="{{ month_year }}">
						{{ total|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
					</td>
				{% endif %}
			{% endfor %}
		{% else %}
			{{ include('compte/table/empty/_totaux_mois_detail.html.twig') }}
		{% endif %}
		{% if table_summary_colspan > 0 %}<td colspan="{{ table_summary_colspan }}" class="td_total bck_black"></td>{% endif %}
	</tr>

	{# FULL #}
	<tr>
		<td colspan="{{ label_colspan }}" class="col_start_bottom bck_{{ sign }}"></td>
		{% if operations['totaux_mois'] is defined %}

			{% for month in visible_months %}
					{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = user.preferences.comptegenreshow and month in detail_months %}
{% set month_is_collapsed = user.preferences.comptegenreshow and month not in detail_months %}
				{% set done =
						current_year > month_year or (current_year == month_year and month < current_month)
							? 'done gras'
							: current_year == month_year and month == current_month
								? 'current'
								: ''
				%}

				{% if month_is_collapsed %}
					<td class="month-cell-span {{ done }} month-detail-collapsed" data-month="{{ month }}" data-year="{{ month_year }}"></td>
				{% elseif operations['totaux_mois'][month] is defined %}
					<td colspan="{{ month_is_detailed ? 2 : 1 }}" class="month-cell-span {{ done }} total_month_full_{{ sign }}" data-month="{{ month }}" data-year="{{ month_year }}">
						{{ operations['totaux_mois'][month]['total']|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
					</td>
				{% else %}
					<td colspan="{{ month_is_detailed ? 2 : 1 }}" class="month-cell-span {{ done }} total_month_full_{{ sign }}" data-month="{{ month }}" data-year="{{ month_year }}">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
				{% endif %}
			{% endfor %}
		{% else %}
			{{ include('compte/table/empty/_totaux_mois_full.html.twig') }}
		{% endif %}
		{% if show_table_totals %}
			<td class="year-total td_total souligne done">{{ operations['total_final']|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
		{% endif %}
		{% if show_table_monthly_average %}
			<td class="year-total{{ not show_table_totals ? ' td_total_border' }} done">{{ (display_month_count > 0 ? operations['total_final'] / display_month_count : 0)|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
		{% endif %}
		{% if show_table_percentage %}
			<td class="year-total{{ not show_table_totals and not show_table_monthly_average ? ' td_total_border' }} done">{{ operations['totaux_mois'] is defined ? 100 : 0 }}</td>
		{% endif %}
	</tr>
