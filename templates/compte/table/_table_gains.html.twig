{% set month_display_family = month_display|split('_')|first %}
{% set show_monthly_gain = user.preferences.showBalanceTable ?? true %}
{% set show_balance_cumulative = user.preferences.showBalanceCumulative ?? true %}
{% set show_annual_gain = user.preferences.showAnnualGain ?? true %}
{% set table_summary_column_count =
	(user.preferences.showTableTotals ?? true ? 1 : 0)
	+ (user.preferences.showTableMonthlyAverage ?? true ? 1 : 0)
	+ (user.preferences.showTablePercentage ?? true ? 1 : 0) %}
{% set revenuAnnuel = 0 %}
{% for gain in gains %}
	{% set revenuAnnuel = gain['cumule'] %}
{% endfor %}
{% if month_colspans is not defined %}
	{% set month_colspans = {} %}
	{% for month in visible_months %}
		{% set month_key = 'm' ~ month %}
		{% set month_colspans = month_colspans|merge({ (month_key): month in detail_months ? 2 : 1 }) %}
	{% endfor %}
{% endif %}

{% set show_gain_grid = show_monthly_gain or show_balance_cumulative %}
{% set annual_gain_compact = not show_monthly_gain or not show_balance_cumulative %}
{% set annual_gain_integrated = show_annual_gain and not annual_gain_compact %}

<div class="gains-table-layout{{ show_annual_gain and not annual_gain_integrated ? ' has-annual-gain' }}{{ not show_gain_grid ? ' annual-gain-only' }}">
{% if show_gain_grid %}
<table class="table compteTable center gains-table{{ annual_gain_integrated ? '' : ' gains-table-summary-columns-' ~ table_summary_column_count }} month-display-{{ month_display }} month-display-{{ month_display_family }}{{ month_display_family in ['one', 'current', 'custom'] and display_month_count != 12 ? ' month-display-compact' }}{{ display_month_count == 12 ? ' month-display-full-range month-display-year' }}" data-table-key="gains">

	{# GAIN MENSUEL #}
	{% if show_monthly_gain %}
	<tr class='tr_head'>
		<th colspan="4" class="th_solde_cache col_start_top alignRight centerHor">Gain mensuel</th>

		{% for month in visible_months %}

				{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = month in detail_months %}
{% set month_is_collapsed = month not in detail_months %}
			{% set month_colspan = month_colspans['m' ~ month]|default(1) %}
			{% set done =
				current_year > month_year or (current_year == month_year and month < current_month)
					? 'done'
					: current_year == month_year and month == current_month
						? 'current normal'
						: 'normal'
			%}

			{# DATAS #}
			{% if month_is_collapsed %}
				<th colspan="1" data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible {{ done }} month-detail-collapsed"></th>
			{% elseif gains[month] is defined %}
				{% set number = gains[month]['gain'] %}

				<th	colspan='{{ month_colspan }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible {{ done }} {{ number < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}">
					{{ number|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</th>

			{% else %}
				<th colspan='{{ month_colspan }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible total_month_full_pos {{ done }}">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</th>
			{% endif %}
		{% endfor %}
		{% if annual_gain_integrated %}
			<th colspan="3" class="year-total col_end_top_solde th_solde_cache_2 souligne">{{ month_display == 'year' and display_month_count == 12 ? 'Gain annuel' : 'Gain sur la période' }}</th>
		{% endif %}
	</tr>
	{% endif %}

	{# GAIN CUMULE #}
	{% if show_balance_cumulative %}
	<tr class='tr_head'>
		<th class="th_solde_cache"></th>
		<th colspan="3" class="th_solde_cache alignRight centerHor">Solde mensuel cumulé</th>

			{% for month in visible_months %}

				{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = month in detail_months %}
{% set month_is_collapsed = month not in detail_months %}
			{% set month_colspan = month_colspans['m' ~ month]|default(1) %}
			{% set done =
					current_year > month_year or (current_year == month_year and month < current_month)
						? 'done'
						: current_year == month_year and month == current_month
							? 'current normal'
							: 'normal'
			%}

			{# DATAS #}
			{% if month_is_collapsed %}
				<th colspan="1" data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible centerHor {{ done }} month-detail-collapsed"></th>
			{% elseif gains[month] is defined %}
				{% set number = gains[month]['cumule'] %}

				<th colspan='{{ month_colspan }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible centerHor {{ done }} {{ number < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}">
					{{ number|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</th>

			{% else %}
				<th colspan='{{ month_colspan }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible centerHor {{ done }} total_month_full_pos">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</th>
			{% endif %}
			{% endfor %}
		{% if annual_gain_integrated %}
			<td
				colspan="3"
				class="year-total th_solde_cache_2 revenuAnnuel {{ revenuAnnuel < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}"
			>
				{{ revenuAnnuel|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
			</td>
		{% endif %}
	</tr>
	{% endif %}
</table>
{% endif %}

{% if show_annual_gain and not annual_gain_integrated %}
	<table class="table compteTable center annual-gain-table{{ annual_gain_compact ? ' is-compact' }}">
		{% if annual_gain_compact %}
			<tr>
				<th>{{ month_display == 'year' and display_month_count == 12 ? 'Gain annuel' : 'Gain sur la période' }}</th>
				<td class="{{ revenuAnnuel < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}">
					{{ revenuAnnuel|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</td>
			</tr>
		{% else %}
			<tr><th>{{ month_display == 'year' and display_month_count == 12 ? 'Gain annuel' : 'Gain sur la période' }}</th></tr>
			<tr>
				<td class="{{ revenuAnnuel < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}">
					{{ revenuAnnuel|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</td>
			</tr>
		{% endif %}
	</table>
{% endif %}
</div>
