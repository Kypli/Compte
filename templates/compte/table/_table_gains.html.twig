{% set month_display_family = month_display|split('_')|first %}
<table class="table compteTable center gains-table month-display-{{ month_display }} month-display-{{ month_display_family }}{{ month_display_family in ['one', 'current', 'custom'] ? ' month-display-compact' }}" data-table-key="gains">

	{# GAIN MENSUEL #}
	<tr class='tr_head'>
		<th colspan="4" class="th_solde_cache col_start_top alignRight centerHor">Gain mensuel</th>

		{% set revenuAnnuel = 0 %}
		{% for gain in gains %}
			{% set revenuAnnuel = gain['cumule'] %}
		{% endfor %}

		{% for month in visible_months %}

				{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = user.preferences.comptegenreshow and month in detail_months %}
{% set month_is_collapsed = user.preferences.comptegenreshow and month not in detail_months %}
			{% set done =
				current_year > month_year or (current_year == month_year and month < current_month)
					? 'done'
					: current_year == month_year and month == current_month
						? 'current normal'
						: 'normal'
			%}

			{# DATAS #}
			{% if month_is_collapsed %}
				<th colspan="1" data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible {{ done }} month-detail-collapsed"></th>
			{% elseif gains[month] is defined %}
				{% set number = gains[month]['gain'] %}

				<th	colspan='{{ month_is_detailed ? 2 : 1 }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible {{ done }} {{ number < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}">
					{{ number|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</th>

			{% else %}
				<th colspan='{{ month_is_detailed ? 2 : 1 }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible total_month_full_pos {{ done }}">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</th>
			{% endif %}
		{% endfor %}
		<th colspan="3" class="year-total col_end_top_solde th_solde_cache_2 souligne">{{ month_display == 'year' and display_month_count == 12 ? 'Gain annuel' : 'Gain sur la période' }}</th>
	</tr>

	{# GAIN CUMULE #}
	<tr class='tr_head'>
		<th class="th_solde_cache"></th>
		<th colspan="3" class="th_solde_cache alignRight centerHor">Gain mensuel cumulé</th>

		{% for month in visible_months %}

				{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = user.preferences.comptegenreshow and month in detail_months %}
{% set month_is_collapsed = user.preferences.comptegenreshow and month not in detail_months %}
			{% set done =
					current_year > month_year or (current_year == month_year and month < current_month)
						? 'done'
						: current_year == month_year and month == current_month
							? 'current normal'
							: 'normal'
			%}

			{# DATAS #}
			{% if month_is_collapsed %}
				<th colspan="1" data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible centerHor {{ done }} month-detail-collapsed"></th>
			{% elseif gains[month] is defined %}
				{% set number = gains[month]['cumule'] %}

				<th colspan='{{ month_is_detailed ? 2 : 1 }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible centerHor {{ done }} {{ number < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}">
					{{ number|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
				</th>

			{% else %}
				<th colspan='{{ month_is_detailed ? 2 : 1 }}' data-month="{{ month }}" data-year="{{ month_year }}" class="month-cell-span month-visible centerHor {{ done }} total_month_full_pos">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</th>
			{% endif %}
		{% endfor %}
		<td
			colspan="3"
			class="year-total th_solde_cache_2 revenuAnnuel {{ revenuAnnuel < 0 ? 'total_month_full_neg' : 'total_month_full_pos' }}"
		>
			{{ revenuAnnuel|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
		</td>
	</tr>
</table>
