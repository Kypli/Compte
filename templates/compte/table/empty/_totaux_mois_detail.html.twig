{% for month in visible_months %}

	{% set done =
			current_year > year or (current_year == year and month < current_month)
				? 'done'
				: current_year == year and month == current_month
					? 'current'
					: ''
	%}
	<td class="month-cell-start total_month_detail_{{ sign }} {{ done }}" data-month="{{ month }}">0</td>
	<td class="month-cell-end total_month_detail_{{ sign }} {{ done }}" data-month="{{ month }}">0</td>
{% endfor %}
