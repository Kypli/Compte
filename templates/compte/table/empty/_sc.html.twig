{% for month in visible_months %}
		{% set month_year = visible_month_years[month]|default(year) %}
{% set month_is_detailed = user.preferences.comptegenreshow and month in detail_months %}
{% set month_is_collapsed = user.preferences.comptegenreshow and month not in detail_months %}
	{% set done =
			current_year > month_year or (current_year == month_year and month < current_month)
				? 'done'
				: current_year == month_year and month == current_month
					? 'current'
					: ''
	%}

	{% if month_is_collapsed %}
		<td
			class='month-cell-span {{ done|trim }} month-detail-collapsed{{ loop.last ? ' month-cell-last' }}'
			data-month="{{ month }}" data-year="{{ month_year }}"
		></td>
	{% elseif month_is_detailed %}
		{# REEL #}
		<td
			class='month-cell-start {{ done|trim }}'
			data-month="{{ month }}" data-year="{{ month_year }}"
			data-scid="{{ subcategory.id }}"
			data-sign="{{ sign }}"
			data-anticipe="0"
			data-target="#modalOperation"
			data-toggle="modal"
		>
			{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}
		</td>

		{# ANTICIPE #}
		<td
			class='month-cell-end {{ done|trim }} anticipe{{ loop.last ? ' month-cell-last' }}'
			data-month="{{ month }}" data-year="{{ month_year }}"
			data-scid="{{ subcategory.id }}"
			data-sign="{{ sign }}"
			data-anticipe="1"
			data-target="#modalOperation"
			data-toggle="modal"
		></td>
	{% else %}
		<td
			class='month-cell-span {{ done|trim }}{{ loop.last ? ' month-cell-last' }}'
			data-month="{{ month }}" data-year="{{ month_year }}"
			data-scid="{{ subcategory.id }}"
			data-sign="{{ sign }}"
			data-anticipe="0"
			data-target="#modalOperation"
			data-toggle="modal"
		>{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
	{% endif %}
{% endfor %}
{% if show_table_totals %}
	<td class="year-total done counterEdit td_total_border">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
{% endif %}
{% if show_table_monthly_average %}
	<td class="year-total done counterEdit{{ not show_table_totals ? ' td_total_border' }}">{{ 0|money_display(money_display_format, money_currency, money_trim_zeros, money_show_zero_decimals) }}</td>
{% endif %}
{% if show_table_percentage %}
	<td class="year-total done counterEdit{{ not show_table_totals and not show_table_monthly_average ? ' td_total_border' }}">0</td>
{% endif %}
