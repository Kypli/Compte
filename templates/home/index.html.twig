{% extends 'base.html.twig' %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('home') }}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('homeConfirm') }}
	{{ encore_entry_script_tags('homeLoginForm') }}
{% endblock %}

{% block title %}A vos comptes{% endblock %}

{% block navbar %}{% endblock %}

{% block body %}
	{% set has_test_cookie = test_user is defined and test_user is not null %}
	{% set show_test_button = not app.user and not has_test_cookie and anonyme is null and (can_create_anonymous_test_session is not defined or can_create_anonymous_test_session) %}

	<div class="container">
		<div class="row mb-3">

			{# LOGO #}
			<div id="logo" class="offset-4 col-4 mt-2 center">
				<img src="https://placehold.co/500x250" class=" m-3" />
			</div>

			{# TITRE #}
			<h2 class="radius-short offset-4 col-4">A vos comptes</h2>

			{# SLOGAN #}
			<h3 class="offset-2 col-8 center taille30 gras">
				Gérez votre argent en toute simplicité.
				<br/>
				Pour une meilleur vision de votre budget !
			</h3>

			<section class="section">
				<div class="row">

					{# MESSAGE D'ACCUEIL #}
					<div class="offset-2 col-8 taille22 mt-2">
						<p>
							{% if app.user or has_test_cookie %}
								Bonjour {{ app.user ? (app.user.anonyme ? 'Visiteur' : app.user.userName) : 'Visiteur' }} et bienvenue sur cette application de gestion de comptes.
							{% else %}
								Bonjour et bienvenue sur cette application de gestion de comptes.
							{% endif %}
						</p>

						{# MESSAGES FLASH SUCCESS #}
						{% for message in app.flashes('login_success') %}
							<div class="flash-notice mt-2 mb-1 bg-success text-center">
								Succès : {{ message }}
							</div>
						{% endfor %}

						{# MESSAGES FLASH LOGIN ERROR #}
						{% for message in app.flashes('login_error') %}
							<div class="flash-notice mt-2 mb-1 bg-danger text-center">
								Erreur : {{ message|raw }}
							</div>
						{% endfor %}

						{# MESSAGES FLASH LOGIN INFOS #}
						{% for message in app.flashes('login_info') %}
							<div class="flash-notice mt-2 mb-1 bg-info text-center">
								{{ message }}
							</div>
						{% endfor %}
					</div>

					{# ESPACE MEMBRE - FORM LOGIN #}
					<div class="{{ app.user or has_test_cookie ? 'col-12' : (show_test_button ? 'offset-1 col-4' : 'offset-4 col-4') }} mt-1">
						{% include 'home/connexion/_index.html.twig' %}
					</div>

					{# TEST #}
					{% if show_test_button %}
						<div class="offset-1 col-5 p-4">
							<div class="row">
								<div class="offset-2 col-8 d-flex justify-content-center mb-0">
									<a href="{{ path('user_add_test') }}" class="p-1">
										<nav>
											<ul>
												<li class="pointeur taille20 home-test-button">
													Tester l'application sans compte
													<span></span>
													<span></span>
													<span></span>
													<span></span>
												</li>
											</ul>
										</nav>
									</a>
								</div>
							</div>
						</div>
					{% endif %}
				</div>
			</section>
		</div>
	</div>
{% endblock %}
