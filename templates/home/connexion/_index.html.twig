{% set remembered_test_user = test_user|default(null) %}
{% set anonymous_context = (app.user and app.user.anonyme) or remembered_test_user %}
{% set session_test_user = remembered_test_user ?: (app.user and app.user.anonyme ? app.user : null) %}

<div class="row mb-4 mt-4 {{ app.user or remembered_test_user ? 'home-connected-actions' }}">

	{% if app.user or remembered_test_user %}
		<div class="col-4 d-flex justify-content-center">
			<a href="{{ app.user ? path('tableau_bord') : path('user_anonyme_dashboard', {'id': remembered_test_user.id}) }}" class="p-1">
				<nav>
					<ul>
						<li class="pointeur taille20">
							Aller au tableau de bord
							<span></span>
							<span></span>
							<span></span>
							<span></span>
						</li>
					</ul>
				</nav>
			</a>
		</div>
		<div class="col-4 d-flex justify-content-center home-register-action">
			<div class="home-register-stack">
				<a href="{{ anonymous_context ? (app.user ? path('user_edit', {'id': app.user.id}) : path('user_anonyme_connect', {'id': session_test_user.id})) : path('logout') }}" class="p-1">
					<nav>
						<ul>
							<li class="pointeur taille20 {{ anonymous_context ? 'home-button-register' : 'home-button-switch' }}">
								{{ anonymous_context ? "S'enregistrer" : 'Changer de compte' }}
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</li>
						</ul>
					</nav>
				</a>
				{% if anonymous_context %}
					<small class="home-register-help">
						<span class="home-register-help-line">
							<strong>Il vous reste {{ test_session_remaining|default('30 jours') }} avant la fin de votre session de test.</strong>
						</span>
						<span class="home-register-help-line">
							N'oubliez pas <strong>de vous enregistrer pour ne pas perdre votre travail.</strong>
						</span>
					</small>
				{% endif %}
			</div>
		</div>
		{% if anonymous_context %}
			<div class="col-4 d-flex justify-content-center">
				<form
					method="post"
					action="{{ path('user_delete_test_session', {'id': session_test_user.id}) }}"
					class="home-test-delete-form p-1"
					data-confirm-test-delete
				>
					<input type="hidden" name="_token" value="{{ csrf_token('delete_test_session' ~ session_test_user.id) }}">
					<button type="submit">
						<nav>
							<ul>
								<li class="pointeur taille20 home-button-danger">
									Supprimer ma session de test
									<span></span>
									<span></span>
									<span></span>
									<span></span>
								</li>
							</ul>
						</nav>
					</button>
				</form>
				<div class="home-confirm-overlay" data-home-confirm-modal hidden>
					<div class="home-confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="home-confirm-title" aria-describedby="home-confirm-text">
						<button type="button" class="home-confirm-close" data-home-confirm-cancel aria-label="Fermer">
							<i class="fas fa-times"></i>
						</button>
						<div class="home-confirm-icon">
							<i class="fas fa-exclamation-triangle"></i>
						</div>
						<h4 id="home-confirm-title">Supprimer la session de test ?</h4>
						<p id="home-confirm-text">
							Cette action supprimera définitivement votre session de test et tout votre travail.
						</p>
						<div class="home-confirm-actions">
							<button type="button" class="home-confirm-cancel" data-home-confirm-cancel>
								Annuler
							</button>
							<button type="button" class="home-confirm-delete" data-home-confirm-delete>
								Supprimer
							</button>
						</div>
					</div>
				</div>
			</div>
		{% else %}
			<div class="col-4 d-flex justify-content-center">
				<a href="{{ path('logout') }}" class="p-1">
					<nav>
						<ul>
							<li class="pointeur taille20 home-button-danger">
								se déconnecter
								<span></span>
								<span></span>
								<span></span>
								<span></span>
							</li>
						</ul>
					</nav>
				</a>
			</div>
		{% endif %}
	{% else %}
		{# FORM LOGIN #}
		{% include 'home/connexion/_form_login.html.twig' %}
	{% endif %}
</div>
